# ---- Database -------------------------------------------------------------
# Railway: reference the Postgres service -> DATABASE_URL=${{Postgres.DATABASE_URL}}
# Local default (if unset): sqlite:///./patients.db
DATABASE_URL=postgresql://app:app@localhost:5432/patients

# ---- Voice agent (Vapi) -----------------------------------------------------
# Private API key from https://dashboard.vapi.ai -> API Keys. When set, the service
# creates/updates the assistant and attaches a phone number on every boot.
VAPI_API_KEY=
# Optional: shared secret for the X-Vapi-Secret header. Derived from VAPI_API_KEY if empty.
VAPI_WEBHOOK_SECRET=
# VAPI_AUTO_SETUP=true
# Public URL of this service (auto-detected on Railway from RAILWAY_PUBLIC_DOMAIN).
PUBLIC_BASE_URL=https://your-app.up.railway.app
# Shown on the dashboard and GET / once provisioned, e.g. +15125550123
VAPI_PHONE_NUMBER=
# Enables POST /admin/vapi/sync when set (send as X-Admin-Token header).
ADMIN_TOKEN=
# Optional overrides
# VAPI_MODEL=gpt-4.1
# VAPI_VOICE_PROVIDER=vapi
# VAPI_VOICE_ID=Elliot

# ---- App -------------------------------------------------------------------
CLINIC_NAME=Maple Valley Health
CLINIC_TIMEZONE=America/New_York
SEED_DEMO_DATA=true
LOG_LEVEL=INFO
# Optional: require X-API-Key on POST/PUT/DELETE. Leave empty for open review access.
API_KEY=
